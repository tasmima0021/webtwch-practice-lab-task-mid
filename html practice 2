<!DOCTYPE html>
<html>
<head>
    <title>University Admission Form</title>
</head>

<body>

<h1>University Admission Form</h1>

<form>

    
    <fieldset>
        <legend>Personal Information</legend>

        Name:<br>
        <input type="text" maxlength="30" required><br><br>

        Email:<br>
        <input type="email" required><br><br>

        Date of Birth:<br>
        <input type="date"><br><br>

        Gender:<br>
        <input type="radio" name="gender"> Male
        <input type="radio" name="gender"> Female
        <br><br>

    </fieldset>

    <br>

  
    <fieldset>
        <legend>Academic Information</legend>

        Select Course:<br>

        <select>
            <option>CSE</option>
            <option>EEE</option>
            <option>BBA</option>
            <option>Architecture</option>
        </select>

        <br><br>

        Interests:<br>

        <input type="checkbox"> Programming
        <input type="checkbox"> Web Design
        <input type="checkbox"> AI

        <br><br>

        Upload Certificate:<br>
        <input type="file">

    </fieldset>

    <br>

    <input type="submit" value="Submit">
    <input type="reset" value="Reset">

</form>

</body>
</html>
