<!DOCTYPE html>
<html>
<head>
    <title>About Page</title>

    <style>

        body{
            font-family: Arial;
            background-color: white;
        }

        .section{
            margin:20px;
            padding:20px;
        }

        #about{
            background-color: lightblue;
        }

        #education{
            background-color: lightgreen;
        }

        #hobbies{
            background-color: lightpink;
        }

        hr{
            height:3px;
            width:80%;
            background-color:black;
        }

    </style>

</head>

<body>

    <h1 align="center">About Me</h1>

    <div id="about" class="section">

        <h2>About Me</h2>

        <p style="color:blue;">
            My name is John Doe.
        </p>

        <p>
            I am a CSE student. I love web development.
        </p>

    </div>

    <hr>

    <div id="education" class="section">

        <h2>Education</h2>

        <p>
            BSc in Computer Science and Engineering.
        </p>

    </div>

    <hr>

    <div id="hobbies" class="section">

        <h2>Hobbies</h2>

        <p>
            Reading books, Playing games and Coding.
        </p>

    </div>

</body>
</html>
